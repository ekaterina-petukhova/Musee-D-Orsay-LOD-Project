orsay:adaptiveReuse a skos:Concept ;
    rdfs:label "Adaptive reuse" ;
    owl:sameAs wd:Q4688776 ;
    skos:definition "Adaptive reuse is the process of reusing an old site or building for a purpose other than the one it was built or designed for. Where a building can no longer function with its original use, a new use through adaptation may be the only way to preserve its heritage significance." ;
    orsay:relationName "documentedIn" ;
    dcterms:relation orsay:wikipediaAdaptiveReuse,
        orsay:adaptiveReuseBuiltHeritageBook ;
    skos:prefLabel "Adaptive reuse" .

