        schema:WebPage ;
    rdfs:label "Adaptive Reuse" ;
    dcterms:description "ICOM-ICAMT reference page on adaptive reuse in museums, naming the Musée d’Orsay a successful and well-known case of a Beaux-Arts railway station adapted for museum use, and noting the surviving ornate gold clock as a trace of its past." ;
    dcterms:publisher orsay:icamt ;
    dcterms:relation orsay:museeOrsay ;
