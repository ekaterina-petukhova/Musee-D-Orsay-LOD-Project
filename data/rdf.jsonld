    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "This documentary explores the Musée d’Orsay through its artworks,\n            architecture, and history. It revisits the transformation of the former\n            railway station into a museum and discusses the preservation and display\n            of collections dating from 1848 to 1914."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Musée d’Orsay - A Great Metamorphosis"
      }
