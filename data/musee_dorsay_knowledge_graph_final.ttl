<https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/reference/musee-dorsay-great-metamorphosis> a crm:E73_Information_Object,
        schema:Movie ;
    dcterms:date "2020"^^xsd:gYear ;
    dcterms:description """This documentary explores the Musée d’Orsay through its artworks,
            architecture, and history. It revisits the transformation of the former
            railway station into a museum and discusses the preservation and display
            of collections dating from 1848 to 1914."""@en ;
    dcterms:title "Musée d’Orsay - A Great Metamorphosis"@en ;
    schema:countryOfOrigin "France"@en ;
    schema:duration "PT53M"^^xsd:duration ;
    schema:isPartOf "Archi & Design"@en ;
    schema:productionCompany <https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/organization/label-image>,
        <https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/organization/label-news>,
        <https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/organization/musees-orsay-orangerie> .

