<https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/object/gare-dorsay> a crm:E24_Physical_Human_Made_Thing,
        schema:LandmarksOrHistoricalBuildings ;
    rdfs:label "Gare d’Orsay"@en ;
    owl:sameAs <https://www.wikidata.org/entity/Q2698691> ;
    ex:designedBy <https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/person/victor-laloux> ;
    ex:hasArchitecturalStyle <https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/concept/beaux-arts-style> ;
    ex:historicalFunction "Railway station and railway hotel."@en ;
    ex:openedFor <https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/event/exposition-universelle-1900> ;
    ex:samePhysicalBuildingDifferentFunction <https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/object/musee-dorsay> ;
    ex:wasModifiedBy <https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/event/orsay-transformation> .

ex:designedBy a rdf:Property ;
    rdfs:label "designed by"@en ;
    rdfs:subPropertyOf dcterms:creator .

ex:digitallyRepresentedBy a rdf:Property ;
    rdfs:label "digitally represented by"@en .

ex:hasArchitecturalStyle a rdf:Property ;
    rdfs:label "has architectural style"@en ;
    rdfs:range skos:Concept .

ex:historicalFunction a rdf:Property ;
    rdfs:label "historical function"@en .

ex:housesWorksBy a rdf:Property ;
    rdfs:label "houses works by"@en .

ex:interiorDesignedBy a rdf:Property ;
    rdfs:label "interior designed by"@en ;
    rdfs:subPropertyOf dcterms:creator .

ex:isCaseOf a rdf:Property ;
    rdfs:label "is case of"@en ;
    rdfs:range skos:Concept .

ex:openedFor a rdf:Property ;
    rdfs:label "opened for"@en .

ex:representsArtMovement a rdf:Property ;
    rdfs:label "represents art movement"@en ;
    rdfs:range skos:Concept .

ex:resultedIn a rdf:Property ;
    rdfs:label "resulted in"@en .

ex:samePhysicalBuildingDifferentFunction a rdf:Property ;
    rdfs:label "same physical building, different function"@en ;
    rdfs:comment "Relates distinct historical identities or functions of the same physical building and does not imply owl:sameAs."@en .

ex:wasModifiedBy a rdf:Property ;
    rdfs:label "was modified by"@en .

