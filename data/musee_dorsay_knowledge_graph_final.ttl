<https://ekaterina-petukhova.github.io/Musee-D-Orsay-LOD-Project/id/concept/adaptive-reuse> a skos:Concept ;
    dcterms:description """Reuse of an existing building for a new function while retaining
              significant material and historical features."""@en ;
    skos:prefLabel "Adaptive reuse"@en .

